# Postgres (docker compose defaults)
DATABASE_URL="postgresql://uprank:uprank@localhost:5432/uprank_dashboard?schema=public"

# Hiring mock API key (same key for billing + product)
MOCK_API_KEY="hm_your_key_here"

# Optional overrides (defaults match the challenge API reference)
BILLING_API_BASE_URL="https://platform.up-rank.com.au/api/hiring-mock/v1"
PRODUCT_API_BASE_URL="https://platform.up-rank.com.au/api/hiring-mock"
